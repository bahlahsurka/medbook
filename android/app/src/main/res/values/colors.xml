<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Referenced by styles.xml's AppTheme (colorPrimary/colorPrimaryDark/
         colorAccent) but never actually shipped by `cap add android`'s
         default template — without this file those three references don't
         resolve and the build fails. Matches theme_color (#2563eb) in
         public/manifest.json so the native chrome (status bar, any AppCompat
         UI) agrees with the PWA's own branding rather than falling back to
         Android's stock Material blue. -->
    <color name="colorPrimary">#2563EB</color>
    <color name="colorPrimaryDark">#1D4ED8</color>
    <color name="colorAccent">#2563EB</color>
</resources>
