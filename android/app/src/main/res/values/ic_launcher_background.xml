<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The adaptive-icon foreground layer (ic_launcher_foreground.png) is
         padded with transparent margin so any OS mask shape doesn't clip the
         glyph — this color shows through that margin, so it's set to the
         icon's own blue rather than the Capacitor default white, which
         would otherwise show as a mismatched box around the glyph on
         launchers that don't apply a close-fitting mask. -->
    <color name="ic_launcher_background">#2563EB</color>
</resources>